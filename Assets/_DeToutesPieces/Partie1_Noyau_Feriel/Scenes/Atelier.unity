--- !u!114 &426739978
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 426739976}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5ac7bc89ccbd046b48c2f9a68cbef5bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DeToutesPieces.Core.AssemblyManager
  steps:
  - title: Premier pied sur la tablette
    instruction: "Posez la tablette inf\xE9rieure sur les cales. Redressez un pied,
      trous vers l'ext\xE9rieur et embout en bas, placez-le \xE0 l'avant gauche,
      puis engagez 2 vis sans les serrer."
    noticePage: 7
    expectedScrewCount: 2
    turntableYaw: 0
    turntableFollowsGuidance: 0
    requirements:
    - {fileID: 1335013181}
    - {fileID: 743335520}
    - {fileID: 464324024}
    - {fileID: 1300506660}
    textHints:
    - "Les pieds sont \xE0 plat : saisissez-en un et redressez-le, l'embout plastique
      vers le bas."
    - "Tournez le pied pour que ses trous soient face \xE0 vous et sur le c\xF4t\xE9
      ext\xE9rieur : la silhouette devient verte."
    verifiedAgainstNotice: 1
  - title: "Deuxi\xE8me pied"
    instruction: "Placez un deuxi\xE8me pied \xE0 l'avant droit et engagez 2 vis,
      sans serrer."
    noticePage: 8
    expectedScrewCount: 2
    turntableYaw: 0
    turntableFollowsGuidance: 0
    requirements:
    - {fileID: 1613433928}
    - {fileID: 1639876394}
    - {fileID: 1420765683}
    textHints:
    - "Les trous du pied doivent \xEAtre vers l'avant et vers la droite."
    verifiedAgainstNotice: 1
  - title: "Troisi\xE8me et quatri\xE8me pieds"
    instruction: "L'ouvrage a \xE9t\xE9 retourn\xE9. Placez les deux derniers pieds
      et engagez 4 vis, sans serrer."
    noticePage: 9
    expectedScrewCount: 4
    turntableYaw: 180
    turntableFollowsGuidance: 0
    requirements:
    - {fileID: 1130293734}
    - {fileID: 182369990}
    - {fileID: 632974613}
    - {fileID: 1267053291}
    - {fileID: 364876155}
    - {fileID: 1160324088}
    textHints:
    - "Comme pour les premiers pieds : embout en bas, trous vers l'ext\xE9rieur."
    verifiedAgainstNotice: 1
  - title: Plateau
    instruction: "Posez le plateau en haut des pieds, puis engagez 4 vis dans les
      deux pieds face \xE0 vous, sans serrer."
    noticePage: 10
    expectedScrewCount: 4
    turntableYaw: 180
    turntableFollowsGuidance: 0
    requirements:
    - {fileID: 396580683}
    - {fileID: 1802411461}
    - {fileID: 940195255}
    - {fileID: 89564178}
    - {fileID: 1308328105}
    textHints:
    - "Le plateau s'ins\xE8re entre le haut des quatre pieds, affleurant leur extr\xE9mit\xE9."
    verifiedAgainstNotice: 1
  - title: "Fixations du plateau, autre c\xF4t\xE9"
    instruction: "L'ouvrage a \xE9t\xE9 retourn\xE9. Engagez les 4 derni\xE8res vis
      du plateau, sans serrer."
    noticePage: 11
    expectedScrewCount: 4
    turntableYaw: 0
    turntableFollowsGuidance: 0
    requirements:
    - {fileID: 169801179}
    - {fileID: 305236686}
    - {fileID: 1027967419}
    - {fileID: 913418846}
    textHints:
    - "Suivez la fl\xE8che jaune : elle indique chaque trou \xE0 garnir."
    verifiedAgainstNotice: 1
  - title: "Serrage final et contr\xF4le"
    instruction: "Prenez la cl\xE9 Allen, engagez son embout dans chaque vis d\xE9sign\xE9e
      et tournez dans le sens des aiguilles d'une montre jusqu'au serrage complet
      (16 vis). V\xE9rifiez ensuite que les pieds sont d'\xE9querre."
    noticePage: 12
    expectedScrewCount: 16
    turntableYaw: 0
    turntableFollowsGuidance: 1
    requirements:
    - {fileID: 464324025}
    - {fileID: 1300506661}
    - {fileID: 169801180}
    - {fileID: 305236687}
    - {fileID: 1639876395}
    - {fileID: 1420765684}
    - {fileID: 1027967420}
    - {fileID: 913418848}
    - {fileID: 182369991}
    - {fileID: 632974614}
    - {fileID: 1802411462}
    - {fileID: 940195256}
    - {fileID: 364876156}
    - {fileID: 1160324089}
    - {fileID: 89564179}
    - {fileID: 1308328106}
    - {fileID: 1594813078}
    textHints:
    - "Approchez l'embout court de la cl\xE9 de la t\xEAte de vis, dans son axe :
      la cl\xE9 s'embo\xEEte."
    - "Tournez le poignet par petits quarts de tour, sens horaire. Vous pouvez rel\xE2cher
      puis reprendre la cl\xE9 : l'avancement est conserv\xE9."
    verifiedAgainstNotice: 1
  startOnPlay: 1
  requireConfirmToAdvance: 1
